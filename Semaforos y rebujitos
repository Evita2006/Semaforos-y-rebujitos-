import threading
import time
import random

CAPACIDAD_CASETA = 5
NUM_MADRILEÑOS = 10  
PROBABILIDAD_REPETIR = 0.75  

portero = threading.Semaphore(CAPACIDAD_CASETA)

def madrileño(id):
    quiere_rebujito = True
    
    while quiere_rebujito:
        print(f" Madrileño {id} está intentando entrar a la caseta.")
        
        with portero:
            print(f" Madrileño {id} ha CONSEGUIDO entrar. ¡Olé!")
            
            tiempo_dentro = random.uniform(1, 5)
            time.sleep(tiempo_dentro)
            
            print(f" Madrileño {id} ha salido de la caseta tras {tiempo_dentro:.2f}s.")
        
        if random.random() < PROBABILIDAD_REPETIR:
            print(f" Madrileño {id} tiene sed y quiere volver a por otro rebujito...")
            time.sleep(1) 
        else:
            print(f" Madrileño {id} ya ha tenido suficiente Feria por hoy.")
            quiere_rebujito = False

print("---  COMIENZA LA FERIA DE ABRIL EN LA CASETA 'VIVA SERGIO RAMOS' ---")

hilos = []
for i in range(1, NUM_MADRILEÑOS + 1):
    t = threading.Thread(target=madrileño, args=(i,))
    hilos.append(t)
    t.start()

for t in hilos:
    t.join()

print("--- El portero ha cerrado la caseta. Fin de la fiesta. ---")
